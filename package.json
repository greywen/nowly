{
  "name": "nowly",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Nowly (此刻) — your local-first personal workspace for Windows, bringing schedules, tasks, notes, time and desktop tools together.",
  "keywords": [
    "personal-workspace",
    "productivity",
    "focus",
    "desktop-widgets",
    "desktop-wallpaper",
    "local-first",
    "calendar",
    "eisenhower-matrix",
    "kanban",
    "notes",
    "pomodoro",
    "focus-timer",
    "tauri",
    "react",
    "typescript",
    "rust",
    "sqlite",
    "windows"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "e2e": "playwright test",
    "tauri": "tauri",
    "icons": "node scripts/generate-icons.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "test:tooling": "node scripts/check-version-sync.mjs",
    "site:build": "node website/scripts/build.mjs",
    "site:preview": "vite website/dist --host 127.0.0.1 --port 4174 --strictPort",
    "site:test": "node --test website/scripts/build.test.mjs website/scripts/showcase-fixtures.test.mjs",
    "site:e2e": "playwright test --config website/playwright.config.ts",
    "site:capture": "node website/scripts/capture-workspace.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "latest",
    "highlight.js": "11.12.0",
    "katex": "0.18.7",
    "lucide-react": "^1.45.0",
    "quill": "2.0.3",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.4",
    "@iconify-json/solar": "^1.2.10",
    "@playwright/test": "latest",
    "@tauri-apps/cli": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "cross-env": "^10.1.0",
    "jsdom": "latest",
    "postcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
